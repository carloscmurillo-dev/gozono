---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactBand from '../components/ContactBand.astro';
import { services, dasSolutions } from '../data/site';
---

<Base title="Servicios" description="DAS indoor y outdoor, enlaces inalámbricos, diseño de redes Wi-Fi y equipos de radiofrecuencia.">
  <PageHero
    eyebrow="Servicios"
    title="Telecomunicaciones"
    lead="Proveedores del Instituto Costarricense de Electricidad (ICE) desde 1995. Nuestras soluciones in-building incluyen el diseño, los equipos, la red, la calibración y la puesta en marcha."
  />

  <section class="container section intro">
    <p>
      Hemos implementado complejos para ICE y múltiples soluciones para proyectos de cobertura indoor y outdoor (hardware, software,
      entrenamiento, torres de telecomunicaciones, etc.). Los problemas de cobertura celular y Wi-Fi, indoor / outdoor, los podemos
      resolver con nuestras soluciones de DAS activo para tecnologías 3G/GSM/UMTS/4G/5G. Podemos suplir las antenas, cables,
      conectores y equipos activos y pasivos para mejorar sus comunicaciones.
    </p>
  </section>

  <section class="container services">
    {
      services.map((s) => (
        <article id={s.icon} class="service">
          <Icon name={s.icon} size={48} />
          <div>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="band">
    <div class="container section stack">
      <div class="heading">
        <p class="eyebrow">Soluciones DAS que ofrecemos</p>
        <h2>Indoor y outdoor</h2>
      </div>
      <div class="grid grid-2">
        {
          dasSolutions.map((d) => (
            <article class="card">
              <h3>{d.title}</h3>
              <p>{d.body}</p>
              <ul>
                {d.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .intro {
    padding-bottom: 48px;
  }
  .intro p {
    font-size: 18px;
    color: var(--c-muted);
    max-width: 860px;
  }
  .services {
    display: flex;
    flex-direction: column;
    padding-bottom: 112px;
  }
  .service {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    padding-block: 32px;
    border-top: 1px solid var(--c-line-2);
    scroll-margin-top: 96px;
  }
  .service h2 {
    font-size: 28px;
    margin-bottom: 12px;
  }
  .service p {
    color: var(--c-muted);
    max-width: 820px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .card ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
</style>
