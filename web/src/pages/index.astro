---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactBand from '../components/ContactBand.astro';
import { credentials, services, dasSolutions, projects, downloads, brands } from '../data/site';
---

<Base>
  <section class="hero">
    <svg class="rings" viewBox="0 0 600 600" aria-hidden="true">
      <circle cx="300" cy="300" r="60" fill="none" stroke="#0F969C" stroke-width="1.5"></circle>
      <circle cx="300" cy="300" r="120" fill="none" stroke="#0C7075" stroke-width="1.2"></circle>
      <circle cx="300" cy="300" r="180" fill="none" stroke="#0C7075" stroke-width="1"></circle>
      <circle cx="300" cy="300" r="240" fill="none" stroke="#294D61" stroke-width="1"></circle>
      <circle cx="300" cy="300" r="295" fill="none" stroke="#294D61" stroke-width="0.8"></circle>
      <circle cx="300" cy="300" r="6" fill="#0F969C"></circle>
      <circle cx="420" cy="300" r="4" fill="#6DA5C0"></circle>
      <circle cx="216" cy="216" r="4" fill="#6DA5C0"></circle>
      <circle cx="300" cy="480" r="4" fill="#6DA5C0"></circle>
      <circle cx="470" cy="470" r="3" fill="#0F969C"></circle>
    </svg>
    <div class="container hero-inner">
      <p class="eyebrow">Ingeniería en telecomunicaciones · Desde 1995</p>
      <h1>Construyendo el futuro de la cobertura inalámbrica</h1>
      <p class="lead">
        Soluciones completas de DAS, Wi-Fi y enlaces backhaul para redes interiores y exteriores — con fibra hasta la antena.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#contacto">Solicitar asesoría</a>
        <a class="btn btn-ghost" href="/servicios">Ver servicios</a>
      </div>
    </div>
  </section>

  <section aria-label="Credenciales" class="creds">
    <div class="container creds-grid">
      {
        credentials.map((c) => (
          <div class="cred">
            <span class="cred-value">{c.value}</span>
            <span class="cred-label">{c.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container section stack">
    <div class="heading">
      <p class="eyebrow">Servicios</p>
      <h2>Conectividad diseñada para cada entorno</h2>
      <p>Diseño, equipos, red, calibración y puesta en marcha: resolvemos problemas de cobertura celular y Wi-Fi, indoor y outdoor.</p>
    </div>
    <div class="grid grid-cards">
      {
        services.map((s) => (
          <a class="card card-link" href={`/servicios#${s.icon}`}>
            <Icon name={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="band">
    <div class="container section stack">
      <div class="heading">
        <p class="eyebrow">Soluciones DAS activo</p>
        <h2>Cobertura total, adentro y afuera</h2>
        <p>Equipos de última generación para maximizar cobertura y capacidad, con velocidades de hasta 5G.</p>
      </div>
      <div class="grid grid-2">
        {
          dasSolutions.map((d) => (
            <article class="das">
              <div class:list={['das-media', d.tone]} aria-hidden="true">
                <svg viewBox="0 0 200 120" width="200" height="120">
                  <path d="M100 100V52" stroke="#E6F1F3" stroke-width="2" fill="none" />
                  <path d="M84 44a22 22 0 0 1 32 0" stroke="#E6F1F3" stroke-width="2" fill="none" />
                  <path d="M70 32a40 40 0 0 1 60 0" stroke="#E6F1F3" stroke-width="2" fill="none" opacity="0.7" />
                  <path d="M56 20a58 58 0 0 1 88 0" stroke="#E6F1F3" stroke-width="2" fill="none" opacity="0.4" />
                  <circle cx="100" cy="52" r="4" fill="#E6F1F3" />
                </svg>
              </div>
              <div class="das-body">
                <h3>{d.title}</h3>
                <p>{d.body}</p>
                <ul>
                  {d.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container section about">
    <div class="stack-sm">
      <p class="eyebrow">Nosotros</p>
      <h2>Más de 20 años respaldan nuestro compromiso</h2>
      <p class="muted">
        Brindamos soluciones de ingeniería confiables e innovadoras a instituciones públicas y privadas en todo el país, adaptándonos
        a cada desafío con tecnología, conocimiento y una atención personalizada que marca la diferencia.
      </p>
      <a href="/nosotros" class="more">Conozca más sobre nosotros →</a>
    </div>
    <div class="stack-sm">
      <p class="eyebrow">Proyectos destacados</p>
      {
        projects.map((p) => (
          <article class="project">
            <div>
              <h3>{p.title}</h3>
              <p>{p.detail}</p>
            </div>
            <span class="pill">{p.tag}</span>
          </article>
        ))
      }
      <a href="/proyectos" class="more">Ver proyectos →</a>
    </div>
  </section>

  <section aria-labelledby="marcas" class="brands">
    <div class="container brands-inner">
      <p id="marcas" class="eyebrow center">Marcas y membresías</p>
      <ul class="brand-grid">
        {brands.map((b) => <li class="placeholder brand">{b}</li>)}
      </ul>
    </div>
  </section>

  <section class="container section stack">
    <div class="split">
      <div class="heading">
        <p class="eyebrow">Recursos</p>
        <h2>Material técnico descargable</h2>
      </div>
      <a href="/recursos/normativas" class="more">Normativas y estándares →</a>
    </div>
    <div class="grid downloads">
      {
        downloads.map((d) => (
          <a class="download" href={d.file} target="_blank" rel="noopener">
            <span>{d.title}</span>
            <span class="pdf">PDF ↓</span>
          </a>
        ))
      }
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--c-line);
  }
  .rings {
    position: absolute;
    right: -120px;
    top: -60px;
    width: 720px;
    height: 720px;
    opacity: 0.55;
  }
  @media (max-width: 720px) {
    .rings {
      width: 460px;
      height: 460px;
      right: -200px;
      top: -80px;
      opacity: 0.35;
    }
  }
  .hero-inner {
    position: relative;
    padding-block: 120px 104px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero h1 {
    max-width: 820px;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
  }
  .hero .lead {
    max-width: 640px;
    font-size: 19px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 8px;
  }

  .creds {
    background: var(--c-surface);
  }
  .creds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    padding-block: 40px;
  }
  .cred {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cred-value {
    font-family: var(--font-head);
    font-size: 36px;
    font-weight: 700;
    color: var(--c-white);
  }
  .cred-label {
    color: var(--c-muted);
    font-size: 15px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .stack-sm {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .das {
    background: var(--c-ink);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .das-media {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .das-media.teal {
    background: var(--c-primary);
  }
  .das-media.slate {
    background: var(--c-slate);
  }
  .das-body {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .das-body h3 {
    font-size: 28px;
  }
  .das-body p {
    color: var(--c-muted);
  }
  .das-body ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .about {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 64px;
    align-items: start;
  }
  .about h2 {
    font-size: clamp(32px, 4vw, 40px);
  }
  .muted {
    color: var(--c-muted);
  }
  .more {
    font-weight: 600;
    align-self: flex-start;
  }
  .project {
    border: 1px solid var(--c-line-2);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }
  .project h3 {
    font-size: 20px;
  }
  .project p {
    margin-top: 4px;
    color: var(--c-muted);
    font-size: 15px;
  }

  .brands {
    border-block: 1px solid var(--c-line);
  }
  .brands-inner {
    padding-block: 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .center {
    text-align: center;
    color: var(--c-sky);
  }
  .brand-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
  }
  .brand {
    height: 64px;
    font-weight: 600;
  }

  .split {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
  }
  .downloads {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .download {
    text-decoration: none;
    background: var(--c-surface);
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    color: var(--c-text);
    font-weight: 600;
  }
  .download:hover {
    border-color: var(--c-accent);
    color: var(--c-white);
  }
  .pdf {
    color: var(--c-accent);
    font-size: 14px;
  }
</style>
