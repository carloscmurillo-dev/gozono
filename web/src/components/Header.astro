---
import { nav, helpdeskUrl } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(`${href}/`));
---

<header class="header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Grupo Ozono, inicio">
      <!-- Logo actual: texto oscuro, por eso va sobre una placa clara. -->
      <span class="logo-plate"><img src="/logo-gozono.png" alt="Grupo Ozono" width="120" height="52" /></span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav id="menu" class="menu" aria-label="Principal">
      <ul>
        {
          nav.map((item) =>
            item.children ? (
              <li class="has-sub">
                <button type="button" class:list={['link', 'sub-toggle', { active: path.startsWith('/recursos') }]} aria-expanded="false">
                  {item.label}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
                <ul class="sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={['link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
        <li><a class="btn btn-primary cta" href={helpdeskUrl}>Portal de soporte</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('open', !open);
  });

  document.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  // Cierra el submenú al hacer clic fuera o con Escape.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLButtonElement>('.sub-toggle[aria-expanded="true"]').forEach((btn) => {
      if (!btn.parentElement?.contains(e.target as Node)) btn.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.sub-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(5, 22, 26, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--c-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
  }
  .logo-plate {
    background: #ffffff;
    border-radius: 12px;
    padding: 4px 10px;
    display: flex;
  }
  .logo-plate img {
    height: 44px;
    width: auto;
  }
  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu > ul {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .link {
    color: var(--c-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    background: none;
    border: 0;
    font-family: inherit;
    cursor: pointer;
    padding: 8px 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .link:hover,
  .link.active {
    color: var(--c-white);
  }
  .link.active {
    box-shadow: inset 0 -2px 0 var(--c-accent);
  }
  .has-sub {
    position: relative;
  }
  .sub {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: -16px;
    min-width: 240px;
    background: var(--c-surface);
    border: 1px solid var(--c-line-2);
    border-radius: 14px;
    padding: 8px;
  }
  .sub-toggle[aria-expanded='true'] + .sub,
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    display: block;
  }
  .sub a {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--c-text);
    text-decoration: none;
    font-size: 15px;
  }
  .sub a:hover {
    background: var(--c-line-2);
  }
  .cta {
    min-height: 44px;
    padding: 10px 20px;
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 1px solid var(--c-slate);
    color: var(--c-text);
    border-radius: 10px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: inline-flex;
    }
    .menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--c-ink);
      border-bottom: 1px solid var(--c-line);
      padding: 8px 24px 24px;
    }
    .menu.open {
      display: block;
    }
    .menu > ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .menu > ul > li {
      border-bottom: 1px solid var(--c-line);
    }
    .menu > ul > li:last-child {
      border: 0;
      padding-top: 16px;
    }
    .link {
      width: 100%;
      padding: 14px 0;
      font-size: 17px;
    }
    .link.active {
      box-shadow: none;
      color: var(--c-accent);
    }
    .sub {
      position: static;
      background: none;
      border: 0;
      padding: 0 0 8px 12px;
    }
    .has-sub:hover .sub {
      display: none;
    }
    .sub-toggle[aria-expanded='true'] + .sub {
      display: block;
    }
    .cta {
      width: 100%;
    }
  }
</style>
