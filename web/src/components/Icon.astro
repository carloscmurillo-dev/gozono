---
import type { IconName } from '../data/site';

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 40 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'das' && (
      <>
        <path d="M12 20V10" />
        <path d="M8 8a5.6 5.6 0 0 1 8 0" />
        <path d="M5 5a10 10 0 0 1 14 0" />
        <circle cx="12" cy="10" r="1.5" />
      </>
    )
  }
  {
    name === 'link' && (
      <>
        <path d="M4 20l3-9" />
        <path d="M20 20l-3-9" />
        <path d="M7 11h10" />
        <path d="M3 6c3-2 6-2 9 0s6 2 9 0" />
      </>
    )
  }
  {
    name === 'wifi' && (
      <>
        <path d="M2 9a15 15 0 0 1 20 0" />
        <path d="M5.5 12.5a10 10 0 0 1 13 0" />
        <path d="M9 16a5 5 0 0 1 6 0" />
        <circle cx="12" cy="19.5" r="1" />
      </>
    )
  }
  {
    name === 'radio' && (
      <>
        <rect x="4" y="9" width="16" height="11" rx="2" />
        <path d="M8 9l8-6" />
        <circle cx="9" cy="14.5" r="2" />
        <path d="M14 13h3" />
        <path d="M14 16h3" />
      </>
    )
  }
</svg>
