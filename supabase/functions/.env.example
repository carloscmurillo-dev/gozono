# Secretos de las Edge Functions. En producción: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.)

# Microsoft 365 / Entra ID: app registration con permiso de aplicación Mail.Send
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Buzón desde el que salen los correos (ej. soporte@gozono.com)
GRAPH_MAIL_FROM=soporte@gozono.com
# A dónde llegan los mensajes del formulario de contacto del sitio
CONTACT_NOTIFY_TO=info@gozono.com

# URL pública del help desk (enlaces en los correos e invitaciones)
HELPDESK_URL=https://soporte.gozono.com

# Secreto compartido con los Database Webhooks (encabezado x-webhook-secret)
WEBHOOK_SECRET=
